# 林梦博客 - 环境配置模板
# 复制此文件为 .env 并填入真实值，不要将 .env 提交到版本库

# 数据库
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# 安全密钥（用于 AES-256-CBC 加密 / 一旦设定后不要变更，否则已加密数据无法解密）
# 生成方法：php -r "echo bin2hex(random_bytes(32));"
SECRET_KEY=

# 站点
SITE_URL=https://example.com
SITE_PATH=

# 是否信任 X-Forwarded-For 头
# 仅当服务器明确位于反向代理后且代理已覆盖此头时设为 true
# Cloudflare 用户无需启用（自动走 HTTP_CF_CONNECTING_IP）
LM_TRUST_PROXY=false
