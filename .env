# 林梦博客 - 环境配置
# 首次使用：访问 域名/setup 运行安装向导，将自动生成本文件
# 或复制 .env.example 为 .env 并手动填写真实值，不要将 .env 提交到版本库

# 数据库
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# 安全密钥（用于 AES-256-CBC 加密 / 一旦设定后不要变更，否则已加密数据无法解密）
# 生成方法：php -r "echo bin2hex(random_bytes(32));"
SECRET_KEY=

# 站点
SITE_URL=https://example.com
SITE_PATH=

# 是否信任 X-Forwarded-For（仅当位于明确配置的反向代理后时启用）
# Cloudflare 用户无需启用（自动走 HTTP_CF_CONNECTING_IP）
LM_TRUST_PROXY=false
