# 敏感凭据（永远不要提交）
.env
.env.*
!.env.example
.user.ini

# 安装标记
/includes/config_installed.php

# 安装目录产生的锁定文件
/setup/.installed

# 用户上传内容
/assets/uploads/*
!/assets/uploads/index.html

# 日志
*.log
/logs/

# 页面缓存（PageCache 运行时生成）
/cache/

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 构建产物（若未来引入构建工具）
/node_modules/
/dist/
/build/

# Trae 计划/文档目录（本地工作产物）
/.trae/
