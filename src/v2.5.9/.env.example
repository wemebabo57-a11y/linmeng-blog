# ============================================================================
# 站点环境配置模板
# ----------------------------------------------------------------------------
# 使用方法（推荐）：
#   1. 直接访问 https://你的域名/setup/ 运行安装向导，向导会自动生成 .env；
#   2. 若无法运行向导，可复制本文件为 .env 并手工填写后访问站点。
# 注意：.env 含数据库密码与加密密钥，请勿提交到版本库或公开目录。
# ============================================================================

# ---- 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ---- 安全密钥（AES-256-GCM 优先，不支持时回退 CBC；CSRF 签名 / 记住登录令牌）----
# 必须保持固定：变更后已加密的数据将无法解密。
# 生成方法：php -r "echo bin2hex(random_bytes(32));"
SECRET_KEY=

# ---- 站点 ----
# 站点完整地址（含协议，结尾不要带斜杠），用于 RSS、OG、OAuth 回调等
SITE_URL=https://example.com
# 部署在子目录时填写子目录（如 /blog），根目录部署留空
SITE_PATH=

# ---- 反向代理 / CDN ----
# 仅当站点位于 Cloudflare 或可信反向代理之后时设为 true。
# 开启后才会采信 CF-Connecting-IP、X-Forwarded-For、X-Forwarded-Proto。
# 用 Cloudflare 需要设为 true，否则记录到的访客 IP 会是 CF 节点 IP，HTTPS 判定也会失效。
# 代价：必须确保服务器只接受代理回源（如防火墙仅放行 CF 网段），否则 XFF 可被伪造。
APP_TRUST_PROXY=false