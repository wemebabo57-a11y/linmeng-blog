# 林梦博客 - 环境配置模板
# 推荐直接访问 /setup/ 完成安装；安装向导会生成 .env 与应用安全参数。
# 如需手动部署，可复制此文件为 .env，并在服务器上自行补充 SECRET_KEY。

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# 站点
SITE_URL=https://example.com
SITE_PATH=

# 是否信任 X-Forwarded-For 头
# 仅当服务器明确位于反向代理后且代理已覆盖此头时设为 true
# Cloudflare 用户无需启用（自动走 HTTP_CF_CONNECTING_IP）
LM_TRUST_PROXY=false
